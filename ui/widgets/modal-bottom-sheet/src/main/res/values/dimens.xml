    <!-- The height of a list item in a modal bottom sheet (taken from the Material specs). -->
    <dimen name="modal_bottom_sheet_list_item_height">56dp</dimen>
    <!-- The left padding of a list item to its contents in a modal bottom sheet (taken from the Material specs). -->
    <dimen name="modal_bottom_sheet_list_item_padding_left">16dp</dimen>
    <!-- The left padding of text to the icon in a list item in a modal bottom sheet (taken from the Material specs). -->
    <dimen name="modal_bottom_sheet_list_item_text_padding_left_icon">32dp</dimen>
    <!-- The icon's height in a list item in a modal bottom sheet (taken from the Material specs). -->
    <dimen name="modal_bottom_sheet_list_item_icon_height">24dp</dimen>
    <!-- The icon's width in a list item in a modal bottom sheet (taken from the Material specs). -->
    <dimen name="modal_bottom_sheet_list_item_icon_width">24dp</dimen>
